{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bounda-website",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  // Only the newsletter's /api/* reaches code; every other request is a static file.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
