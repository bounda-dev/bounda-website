---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  readonly title?: string;
  readonly description?: string;
  /** Pages that should not be indexed, such as the 404 page. */
  readonly noindex?: boolean;
}

const {
  title = "Bounda — Event sourcing and CQRS for TypeScript",
  description = "Your tables keep the last write. Bounda keeps every change, so any view can be rebuilt from it. Plain TypeScript modules, inferred types, one database.",
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://bounda.dev");
const canonicalUrl = new URL(Astro.url.pathname, site);
const socialImage = new URL("/og.jpg", site);
const socialImageAlt = "The Bounda symbol as a machined monolith whose foot becomes the global stream, beside the headline: Event sourcing without the ceremony.";
---

<!doctype html>
<html lang="en" class="still">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#121314" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#eceae4" media="(prefers-color-scheme: light)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Bounda" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- The scroll position drives the story, so a reload starts it from the top. -->
    <script is:inline>if ("scrollRestoration" in history) history.scrollRestoration = "manual";</script>

    <!-- The page is static (.still) until this runs: without JavaScript, or with reduced motion, it
         stays a plain page. A mode the visitor chose wins over the system's. Both before first paint. -->
    <script is:inline>
      (function () {
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.remove("still");
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>

    <!-- All three faces are on the first screen: the headline, the lead and the install command. -->
    <Font cssVariable="--font-science-gothic" preload />
    <Font cssVariable="--font-ibm-plex-sans" preload />
    <Font cssVariable="--font-red-hat-mono" preload />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "26093f976db946eeba633b04b7def982"}'></script>
  </body>
</html>
