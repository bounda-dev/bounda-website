---
import Footer from "../components/footer.astro";
import Nav from "../components/nav.astro";
import BaseLayout from "../layouts/base.astro";
---

<BaseLayout title="Page not found — Bounda" description="There is no page at this address.">
  <Nav />
  <main id="main-content" class="not-found">
    <div class="wrap">
      <p class="label">404</p>
      <h1 class="display">No page at this position.</h1>
      <p>The address may have changed. The documentation and the code are where they were.</p>
      <div class="links">
        <a class="text-link" href="/">Home</a>
        <a class="text-link" href="https://docs.bounda.dev/getting-started/">Documentation</a>
        <a class="text-link dim" href="https://github.com/bounda-dev/bounda">GitHub</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    min-height: 100vh;
    padding: 120px 0 80px;
  }

  .wrap {
    width: 100%;
  }

  h1 {
    max-width: 14ch;
    margin: 18px 0 22px;
    font-size: clamp(2.1rem, 1.2rem + 3.6vw, 4.8rem);
    line-height: 0.98;
    letter-spacing: -0.012em;
  }

  p:not(.label) {
    max-width: 40ch;
    margin: 0 0 32px;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px 28px;
  }
</style>
