---
import type { GetStaticPaths } from "astro";
import IndexPage from "../../../components/blog/index-page.astro";
import { type Locale, TRANSLATED_LOCALES } from "../../../i18n";

export const getStaticPaths = (() => TRANSLATED_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
---

<IndexPage locale={locale} />
