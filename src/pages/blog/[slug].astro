---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import { AUTHOR, formatDate, KIND_LABEL, type Post, posts, readingMinutes } from "../../blog";
import Footer from "../../components/footer.astro";
import Install from "../../components/install.astro";
import Nav from "../../components/nav.astro";
import BaseLayout from "../../layouts/base.astro";
import "../../styles/prose.css";

export const getStaticPaths = (async () =>
  (await posts()).map((post) => ({ params: { slug: post.id }, props: { post } }))) satisfies GetStaticPaths;

interface Props {
  readonly post: Post;
}

const { post } = Astro.props;
const { title, description, date, updated, kind, tryIt, draft } = post.data;
const { Content } = await render(post);
const minutes = readingMinutes(post);
const others = (await posts()).filter(({ id }) => id !== post.id).slice(0, 3);

const site = Astro.site ?? new URL("https://bounda.dev");
const url = new URL(`/blog/${post.id}/`, site).href;
const image = new URL(`/blog/${post.id}/og.png`, site);

// What the page is, for search engines and the assistants that cite it.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url,
  mainEntityOfPage: url,
  image: image.href,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  inLanguage: "en",
  author: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url },
  publisher: { "@id": `${site.href}#organization` },
  isPartOf: { "@type": "Blog", name: "Bounda blog", url: new URL("/blog/", site).href },
  about: { "@id": `${site.href}#bounda` },
};
---

<BaseLayout
  title={`${title} — Bounda`}
  description={description}
  image={{ url: image, alt: `${title}. ${description}`, type: "image/png" }}
  article={{ published: date, modified: updated }}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>
  <Nav />
  <main id="main-content" class="post">
    <article class="wrap">
      <header class="head">
        <p class="label crumbs">
          <a href="/blog/">Blog</a><span aria-hidden="true">/</span>{KIND_LABEL[kind]}
          {draft && <span class="draft">Draft</span>}
        </p>
        <h1 class="display">{title}</h1>
        <p class="lead">{description}</p>
        <p class="meta">
          <span>By <a href={AUTHOR.url}>{AUTHOR.name}</a></span>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span>{minutes} min read</span>
        </p>
      </header>
      <div class="prose">
        <Content />
      </div>
      <svg class="close" viewBox="0 0 35 65" aria-hidden="true"><path d="M25 0h10v65H25v-8H0v-6h25z"></path></svg>
    </article>

    <section class="wrap after" aria-labelledby="try-it">
      <div class="box">
        <p class="label eyebrow" id="try-it">Try it</p>
        {tryIt && <a class="text-link" href={tryIt.href}>{tryIt.label}</a>}
        <p>One command scaffolds a working app: an aggregate, a read model and a test that already passes.</p>
        <Install />
        <div class="links">
          <a class="text-link" href="https://docs.bounda.dev/getting-started/">Read the docs</a>
          <a class="text-link dim" href="/blog/rss.xml">Follow by RSS</a>
        </div>
      </div>
      {
        others.length > 0 && (
          <nav class="more" aria-label="More posts">
            <p class="label">More posts</p>
            <ul>
              {others.map((other) => (
                <li>
                  <a href={`/blog/${other.id}/`}>{other.data.title}</a>
                  <time datetime={other.data.date.toISOString()}>{formatDate(other.data.date)}</time>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .post {
    padding: clamp(112px, 16vh, 160px) 0 0;
  }

  article {
    position: relative;
    padding-bottom: 56px;
  }

  .head {
    max-width: 68ch;
    margin-bottom: 48px;
  }

  .crumbs {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--text);
  }

  .draft {
    margin-left: 6px;
    padding: 4px 6px;
    border: 1px solid var(--warning);
    color: var(--warning);
  }

  h1 {
    margin: 20px 0 22px;
    font-size: clamp(2.1rem, 1.3rem + 2.8vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.012em;
  }

  .lead {
    margin: 0 0 26px;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    font: 400 0.8125rem/1.4 var(--font-mono);
    color: var(--muted);
  }

  .meta a {
    color: var(--text);
    text-decoration: none;
  }

  .meta a:hover {
    text-decoration: underline;
  }

  /* The ⅃ closes the post: the corner of a thing that is complete (DESIGN.md). */
  .close {
    display: block;
    width: 13px;
    height: 24px;
    margin: 8px 0 0 calc(min(68ch, 100%) - 13px);
    fill: var(--accent);
  }

  .after {
    display: grid;
    gap: 56px;
    padding-top: 56px;
    padding-bottom: clamp(80px, 12vh, 128px);
    border-top: 1px solid var(--rule);
  }

  .box {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
    max-width: 620px;
  }

  .box p:not(.label) {
    margin: 0;
    color: var(--muted);
  }

  .eyebrow {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
  }

  .more ul {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .more li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    justify-content: space-between;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }

  .more a {
    text-decoration: none;
  }

  .more a:hover {
    color: var(--accent-text);
  }

  .more time {
    font: 400 0.8125rem/1.6 var(--font-mono);
    color: var(--muted);
  }
</style>
