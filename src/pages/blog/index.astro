---
import { AUTHOR, formatDate, KIND_LABEL, posts, readingMinutes } from "../../blog";
import Footer from "../../components/footer.astro";
import Nav from "../../components/nav.astro";
import BaseLayout from "../../layouts/base.astro";

const all = await posts();
const site = Astro.site ?? new URL("https://bounda.dev");
const title = "Blog — Bounda";
const description =
  "Essays, tutorials and measurements on event sourcing and CQRS in TypeScript, with Bounda as the worked example.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Bounda blog",
  description,
  url: new URL("/blog/", site).href,
  inLanguage: "en",
  publisher: { "@id": `${site.href}#organization` },
  author: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url },
  blogPost: all.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    url: new URL(`/blog/${post.id}/`, site).href,
    datePublished: post.data.date.toISOString(),
  })),
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>
  <Nav />
  <main id="main-content" class="blog">
    <div class="wrap">
      <header class="head">
        <p class="label">Blog</p>
        <h1 class="display">Event sourcing, written down.</h1>
        <p class="lead">{description}</p>
        <a class="text-link dim" href="/blog/rss.xml">Follow by RSS</a>
      </header>
      {
        all.length === 0 ? (
          <p class="empty">The first post is on its way.</p>
        ) : (
          <ol class="ledger">
            {all.map((post, index) => (
              <li>
                <span class="position">{String(all.length - index).padStart(3, "0")}</span>
                <div class="entry">
                  <p class="label">
                    {KIND_LABEL[post.data.kind]}
                    {post.data.draft && <span class="draft">Draft</span>}
                  </p>
                  <h2>
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h2>
                  <p class="description">{post.data.description}</p>
                </div>
                <p class="when">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  <span>{readingMinutes(post)} min read</span>
                </p>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .blog {
    padding: clamp(112px, 16vh, 160px) 0 clamp(80px, 12vh, 128px);
  }

  .head {
    max-width: 68ch;
    margin-bottom: 56px;
  }

  h1 {
    margin: 20px 0 22px;
    font-size: clamp(2.1rem, 1.2rem + 3.6vw, 4.2rem);
    line-height: 0.98;
    letter-spacing: -0.012em;
  }

  .lead {
    margin: 0 0 26px;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .empty {
    color: var(--muted);
  }

  /* The ledger grammar: position first, in mono and muted; a hairline between entries. */
  .ledger {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .ledger li {
    display: grid;
    grid-template-columns: 4.5ch minmax(0, 1fr) auto;
    gap: 8px 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
  }

  .position,
  .when {
    font: 400 0.8125rem/1.9 var(--font-mono);
    color: var(--muted);
  }

  .when {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin: 0;
  }

  .entry {
    max-width: 68ch;
  }

  .draft {
    margin-left: 12px;
    padding: 3px 5px;
    border: 1px solid var(--warning);
    color: var(--warning);
  }

  h2 {
    margin: 10px 0 8px;
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 104%;
    font-size: 1.5rem;
    line-height: 1.15;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent-text);
  }

  .description {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .ledger li {
      grid-template-columns: minmax(0, 1fr);
    }

    .position {
      display: none;
    }

    .when {
      flex-direction: row;
      gap: 16px;
      align-items: baseline;
    }
  }
</style>
