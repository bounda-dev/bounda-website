<button class="theme-toggle" type="button" data-theme-toggle>
  <span class="disc" aria-hidden="true"></span>
  <span class="visually-hidden" data-theme-label>Switch mode</span>
</button>

<style>
  .theme-toggle {
    appearance: none;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 26px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.16s var(--ease),
      border-color 0.16s var(--ease);
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--muted);
  }

  .disc {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }
</style>

<script>
  import { currentTheme, onThemeChange, setTheme, type Theme } from "../scripts/theme";

  const label = (theme: Theme): string =>
    theme === "dark" ? "Dark mode. Switch to light" : "Light mode. Switch to dark";

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    const text = button.querySelector("[data-theme-label]");
    const sync = (theme: Theme): void => {
      if (text) text.textContent = label(theme);
    };
    sync(currentTheme());
    onThemeChange(sync);
    button.addEventListener("click", () => setTheme(currentTheme() === "dark" ? "light" : "dark"));
  }
</script>
