---
import Lockup from "./lockup.astro";
---

<footer class="footer">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Bounda home"><Lockup /></a>
    <ul>
      <li><a class="link" href="https://docs.bounda.dev/getting-started/">Documentation</a></li>
      <li><a class="link" href="https://github.com/bounda-dev/bounda">GitHub</a></li>
      <li><a class="link" href="https://www.npmjs.com/org/bounda-dev">npm</a></li>
      <li><a class="link" href="https://github.com/bounda-dev/bounda/blob/main/LICENSE">Apache 2.0</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 5;
    background: var(--bg);
    border-top: 1px solid var(--rule);
    padding: 28px 0 36px;
  }

  .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    color: var(--text);
    line-height: 0;
  }

  .brand :global(.lockup) {
    height: 19px;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .link {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 125%;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }

  .link:hover {
    color: var(--text);
  }
</style>
