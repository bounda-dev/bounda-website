---
import Install from "../install.astro";
---

<section class="hero">
  <div class="copy" id="hero-copy">
    <p class="label eyebrow" data-enter>Event sourcing and CQRS for TypeScript</p>
    <h1 class="display">
      <span class="line"><span data-rise style="--enter-delay: 0.06s">Event sourcing</span></span>
      <span class="line"><span data-rise style="--enter-delay: 0.14s">without the</span></span>
      <span class="line"><span data-rise class="quiet" style="--enter-delay: 0.22s">ceremony.</span></span>
    </h1>
    <p class="lead-short" data-enter style="--enter-delay: 0.38s">
      <b>Keep every change as an ordered fact.</b> Rebuild any view from it, on one database.
    </p>
  </div>
  <div class="foot" id="hero-foot">
    <p class="lead" data-enter style="--enter-delay: 0.38s">
      <b>Keep every change as an ordered fact and rebuild any view from it.</b> Plain TypeScript modules, inferred types, one
      database. No broker to run.
    </p>
    <div class="actions" data-enter style="--enter-delay: 0.46s">
      <Install />
      <div class="links">
        <a class="text-link" href="https://docs.bounda.dev/getting-started/">Read the docs</a>
        <a class="text-link dim" href="https://github.com/bounda-dev/bounda">GitHub</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100vh;
    height: 100svh;
    min-height: 620px;
    padding: clamp(112px, 17vh, 168px) var(--gutter) 0;
  }

  .copy {
    grid-row: 1;
    position: relative;
    z-index: 1;
    will-change: transform;
  }

  .eyebrow {
    display: flex;
    gap: 14px;
    align-items: center;
    margin: 0 0 clamp(16px, 2.4vh, 26px);
  }

  .eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--accent);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.15rem, 0.85rem + 4.8vw, 5.75rem);
    line-height: 0.98;
    letter-spacing: -0.012em;
    color: var(--text);
  }

  /* Each line rises from its own baseline, the way new entries arrive at the end. */
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  .line > span {
    display: block;
  }

  h1 .quiet {
    color: var(--muted);
  }

  .lead-short {
    display: none;
  }

  .foot {
    grid-row: 3;
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: minmax(0, 27rem) auto;
    gap: clamp(20px, 3vw, 48px);
    align-items: end;
    justify-content: start;
    padding-bottom: clamp(26px, 6vh, 60px);
  }

  .lead {
    margin: 0;
    max-width: 30rem;
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
    line-height: 1.55;
    color: var(--muted);
  }

  .lead b,
  .lead-short b {
    font-weight: 500;
    color: var(--text);
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }

  .links {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  @media (max-width: 1100px) {
    .foot {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 92px;
    }

    .foot {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding-bottom: 22px;
    }

    .lead {
      display: none;
    }

    .lead-short {
      display: block;
      max-width: 30ch;
      margin: 16px 0 0;
      font-size: 1rem;
      line-height: 1.45;
      color: var(--muted);
    }

    .actions {
      align-items: stretch;
    }
  }
</style>
