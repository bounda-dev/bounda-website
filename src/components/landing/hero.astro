---
import Actions from "../actions.astro";
---

<section class="hero">
  <div class="copy" id="hero-copy">
    <p class="label eyebrow" data-enter>Event sourcing and CQRS for TypeScript</p>
    <h1 class="display">
      <span class="line" data-enter style="--enter-delay: 0.05s">Event sourcing</span>{" "}
      <span class="line" data-enter style="--enter-delay: 0.12s">without the</span>{" "}
      <span class="line quiet" data-enter style="--enter-delay: 0.19s">ceremony.</span>
    </h1>
    <p class="lead-short" data-enter style="--enter-delay: 0.28s">
      <b>Your tables keep the last write. Bounda keeps every change.</b> Rebuild any view from it, on one database.
    </p>
  </div>
  <div class="foot" id="hero-foot">
    <p class="lead" data-enter style="--enter-delay: 0.28s">
      <b>Your tables keep the last write. Bounda keeps every change.</b> Rebuild any view, explain any past state. Plain
      TypeScript modules, inferred types, one database, no broker.
    </p>
    <Actions data-enter style="--enter-delay: 0.36s" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100vh;
    height: 100svh;
    min-height: 620px;
    padding: clamp(112px, 17vh, 168px) var(--gutter) 0;
  }

  .copy {
    grid-row: 1;
    position: relative;
    z-index: 1;
    will-change: transform;
  }

  .eyebrow {
    display: flex;
    gap: 14px;
    align-items: center;
    margin: 0 0 clamp(16px, 2.4vh, 26px);
  }

  .eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--accent);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.15rem, 0.85rem + 4.8vw, 5.75rem);
    line-height: 0.98;
    letter-spacing: -0.012em;
    color: var(--text);
  }

  /* Each line enters on its own, the way new entries arrive at the end. */
  .line {
    display: block;
  }

  h1 .quiet {
    color: var(--muted);
  }

  .lead-short {
    display: none;
  }

  .foot {
    grid-row: 3;
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: minmax(0, 27rem) auto;
    gap: clamp(20px, 3vw, 48px);
    align-items: end;
    justify-content: start;
    padding-bottom: clamp(26px, 6vh, 60px);
  }

  /* The script fades the foot as the story starts; whatever has focus in it stays in sight. */
  .foot:focus-within {
    opacity: 1 !important;
  }

  .lead {
    margin: 0;
    max-width: 30rem;
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
    line-height: 1.55;
    color: var(--muted);
  }

  .lead b,
  .lead-short b {
    font-weight: 500;
    color: var(--text);
  }

  @media (max-width: 1100px) {
    .foot {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 92px;
    }

    .foot {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding-bottom: 22px;
    }

    .lead {
      display: none;
    }

    .lead-short {
      display: block;
      max-width: 30ch;
      margin: 16px 0 0;
      font-size: 1rem;
      line-height: 1.45;
      color: var(--muted);
    }
  }
</style>
