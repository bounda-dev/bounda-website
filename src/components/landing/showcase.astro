---
import { Code } from "astro:components";
import CommandIllustration from "../illustrations/command.astro";
import EventSourcingIllustration from "../illustrations/event-sourcing.astro";
import ProjectionIllustration from "../illustrations/projection.astro";
import ViewQueryIllustration from "../illustrations/view-query.astro";

const steps = [
  {
    num: "01",
    tagline: "Define the command",
    label: "Command",
    illustration: "command",
    code: `// app/domain/order/commands/place-order.ts
import { DomainError } from "@bounda-dev/core";
import type { Command } from "./+types/place-order";

export const payload = ({ z }: Command.PayloadArgs) =>
  z.object({
    orderId: z.uuid(),
    customerId: z.string().min(1),
    items: z.array(z.object({ productId: z.string(), quantity: z.int().positive(), price: z.number().positive() })).min(1),
  });

export const handler = ({ command, state, events }: Command.HandlerArgs) => {
  if (state.status !== undefined) {
    throw new DomainError(\`Order \${command.aggregateId} was already placed\`);
  }
  const { customerId, items } = command.payload;
  const total = items.reduce((sum, item) => sum + item.quantity * item.price, 0);
  return [events.orderPlaced({ customerId, items, total })];
};`,
  },
  {
    num: "02",
    tagline: "Define the event",
    label: "Event",
    illustration: "event-sourcing",
    code: `// app/domain/order/order-placed.ts
import type { Event } from "./+types/order-placed";

export const payload = ({ z }: Event.PayloadArgs) =>
  z.object({
    customerId: z.string(),
    items: z.array(z.object({ productId: z.string(), quantity: z.int().positive(), price: z.number().positive() })),
    total: z.number().positive(),
  });

export const apply = ({ state, event }: Event.ApplyArgs) => ({
  ...state,
  status: "placed" as const,
  customerId: event.payload.customerId,
  items: event.payload.items,
  total: event.payload.total,
  placedAt: event.timestamp,
});`,
  },
  {
    num: "03",
    tagline: "Project the read model",
    label: "Projection",
    illustration: "projection",
    code: `// app/read/my-orders/projections/order-placed.ts
import type { Projection } from "./+types/order-placed";

export const project = async ({ event, table }: Projection.Args) => {
  await table.insert({
    orderId: event.aggregateId,
    customerId: event.payload.customerId,
    status: "placed",
    total: event.payload.total,
  });
};`,
  },
  {
    num: "04",
    tagline: "Define the view",
    label: "View",
    illustration: "view-query",
    code: `// app/read/my-orders/view.ts
import type { View } from "./+types/view";

export const fields = ({ f }: View.FieldsArgs) => ({
  orderId: f.string().primaryKey(),
  customerId: f.string().index(),
  status: f.string(),
  total: f.number(),
});`,
  },
  {
    num: "05",
    tagline: "Query the result",
    label: "Query",
    illustration: "view-query",
    code: `// app/read/my-orders/queries/get-my-orders.ts
import type { Query } from "./+types/get-my-orders";

export const payload = ({ z }: Query.PayloadArgs) => z.object({ customerId: z.string().min(1) });

export const repository = ({ table, customerId }: Query.RepositoryArgs) =>
  table.findMany({ where: { customerId }, orderBy: { field: "total", direction: "desc" } });

export const handler = ({ repositoryData }: Query.HandlerArgs) => repositoryData;`,
  },
];

// Deduplicated pipeline nodes (unique illustration keys, preserving order)
const pipelineNodes: { illustration: string; stepIndices: number[] }[] = [];
steps.forEach((step, i) => {
  const existing = pipelineNodes.find((n) => n.illustration === step.illustration);
  if (existing) {
    existing.stepIndices.push(i);
  } else {
    pipelineNodes.push({ illustration: step.illustration, stepIndices: [i] });
  }
});
// Map from step index → pipeline node index
const stepToPipelineIndex = steps.map((step) => pipelineNodes.findIndex((n) => n.illustration === step.illustration));
---

<section class="l-showcase frontal-entry reveal" id="showcase">
  <div class="container">
    <div class="l-showcase-header reveal">
      <p class="section-label">How it works</p>
      <h2 class="gradient-text">Bounda<br />in a nutshell</h2>
    </div>

    <div class="l-showcase-grid">
      <!-- Left: sticky pipeline (desktop only) -->
      <div class="l-pipeline" aria-hidden="true">
        {pipelineNodes.map((node, i) => (
          <Fragment>
            <div class="l-pipeline-node" data-pipeline-index={i}>
              <div class="l-pipeline-illus">
                {node.illustration === "command" && <CommandIllustration />}
                {node.illustration === "event-sourcing" && <EventSourcingIllustration />}
                {node.illustration === "projection" && <ProjectionIllustration />}
                {node.illustration === "view-query" && <ViewQueryIllustration />}
              </div>
            </div>
            {i < pipelineNodes.length - 1 && (
              <div class="l-pipeline-connector">
                <div class="l-pipe-line"></div>
                <div class="l-pipe-dot"></div>
              </div>
            )}
          </Fragment>
        ))}
      </div>

      <!-- Right: scrollable steps -->
      <div class="l-showcase-steps">
        {steps.map((step, i) => (
          <div class="showcase-step reveal" data-step-index={i} data-pipeline-target={stepToPipelineIndex[i]}>
            <div class="step-header">
              <span class="step-num">{step.num}</span>
              <span class="step-tagline">{step.tagline}</span>
            </div>

            <!-- Illustration shown only on mobile -->
            <div class="step-illus-mobile" aria-hidden="true">
              {step.illustration === "command" && <CommandIllustration />}
              {step.illustration === "event-sourcing" && <EventSourcingIllustration />}
              {step.illustration === "projection" && <ProjectionIllustration />}
              {step.illustration === "view-query" && <ViewQueryIllustration />}
            </div>

            <div class="l-code-frame">
              <div class="l-code-frame-bar">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </div>
              <div class="l-code-panel">
                <Code code={step.code} lang="typescript" theme="github-dark" class="code-dark" />
                <Code code={step.code} lang="typescript" theme="github-light" class="code-light" />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .l-showcase {
    padding-block: var(--section-gap);
  }

  .l-showcase-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
    max-width: 44ch;
  }

  /* ── Grid layout ─────────────────────────────────────────── */
  .l-showcase-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 960px) {
    .l-showcase-grid {
      grid-template-columns: 28% 1fr;
      gap: 8rem;
      align-items: start;
    }
  }

  /* ── Pipeline (left column, desktop only) ─────────────────── */
  .l-pipeline {
    display: none;
    flex-direction: column;
    align-items: center;
    position: sticky;
    top: 80px;
    padding-block: 2rem;
  }

  @media (min-width: 960px) {
    .l-pipeline {
      display: flex;
    }
  }

  .l-pipeline-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 0.75rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 2px);
    width: 100%;
    transition: border-color 0.4s ease, box-shadow 0.4s ease, transform 0.4s ease;
  }

  .l-pipeline-node[data-active] {
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow:
      0 0 30px rgba(59, 130, 246, 0.12),
      inset 0 0 20px rgba(59, 130, 246, 0.04);
    transform: scale(1.02);
  }

  .l-pipeline-illus {
    width: 100%;
  }

  /* Pipeline connector */
  .l-pipeline-connector {
    position: relative;
    width: 2px;
    height: 28px;
    background: var(--border);
    flex-shrink: 0;
  }

  .l-pipe-line {
    width: 100%;
    height: 100%;
    background: var(--border);
  }

  .l-pipe-dot {
    position: absolute;
    top: -3px;
    left: 50%;
    transform: translateX(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px rgba(59, 130, 246, 0.5);
    animation: pipeDot 2.5s ease-in-out infinite;
  }

  @keyframes pipeDot {
    0%   { top: -3px; opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { top: calc(100% - 3px); opacity: 0; }
  }

  /* ── Steps (right column) ─────────────────────────────────── */
  .l-showcase-steps {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .showcase-step {
    min-height: 30vh;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block: 2rem;
  }

  .step-header {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .step-num {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.05em;
    opacity: 0.8;
  }

  .step-tagline {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    font-weight: 600;
    color: var(--fg);
    line-height: 1.3;
  }

  /* Mobile illustration — hidden on mobile to reduce scroll, visible mid-range */
  .step-illus-mobile {
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 2px);
  }

  @media (max-width: 767px) {
    .step-illus-mobile {
      display: none;
    }
  }

  @media (min-width: 960px) {
    .step-illus-mobile {
      display: none;
    }
  }

  /* ── Code frame ───────────────────────────────────────────── */
  .l-code-frame {
    border-radius: calc(var(--radius) + 4px);
    box-shadow:
      0 0 0 1px var(--border),
      0 20px 60px rgba(0, 0, 0, 0.4),
      0 0 60px rgba(59, 130, 246, 0.05);
    overflow: hidden;
    transition: box-shadow 0.3s;
  }

  .l-code-frame:hover {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--border) 80%, rgba(59, 130, 246, 0.3)),
      0 24px 70px rgba(0, 0, 0, 0.5),
      0 0 80px rgba(59, 130, 246, 0.08);
  }

  :global([data-theme="light"]) .l-code-frame {
    box-shadow:
      0 0 0 1px var(--border),
      0 8px 30px rgba(0, 0, 0, 0.08),
      0 0 40px rgba(59, 130, 246, 0.03);
  }

  :global([data-theme="light"]) .l-code-frame:hover {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--border) 80%, rgba(59, 130, 246, 0.3)),
      0 12px 40px rgba(0, 0, 0, 0.12),
      0 0 60px rgba(59, 130, 246, 0.05);
  }

  :global([data-theme="light"]) .l-code-panel :global(.code-dark) { display: none; }
  :global([data-theme="dark"]) .l-code-panel :global(.code-light) { display: none; }

  .l-code-frame-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 60%, var(--bg));
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-red    { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green  { background: #28c840; }

  .l-code-panel {
    background: var(--surface);
    padding: 1rem 1.25rem;
    overflow: clip;
  }

  .l-code-panel :global(pre) {
    background: transparent !important;
    padding: 0 !important;
    margin: 0;
    font-size: 0.82rem;
    line-height: 1;
    overflow-x: auto;
    overflow-y: hidden;
  }

  /* Collapse blank lines Shiki renders as empty spans */
  .l-code-panel :global(.line:empty) {
    display: none;
  }

  .l-code-panel :global(.line) {
    display: block;
  }

  @media (max-width: 767px) {
    .showcase-step {
      min-height: 0;
      padding-block: 1.5rem;
    }

    .l-showcase {
      padding-block-end: 1rem;
    }
  }

  /* Reduced motion overrides */
  @media (prefers-reduced-motion: reduce) {
    .l-pipe-dot {
      animation: none;
      opacity: 0.4;
    }

    .l-pipeline-node {
      transition: none;
    }
  }
</style>
