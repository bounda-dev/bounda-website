---
const command = "npm create bounda@latest my-app";
---

<section class="l-cta" id="get-started">
  <div class="l-cta-glow" aria-hidden="true"></div>
  <div class="container l-cta-inner">
    <p class="section-label">Get Started</p>
    <h2 class="gradient-text">Up and running in seconds</h2>

    <div class="l-terminal">
      <div class="l-terminal-bar">
        <span class="dot dot-red"></span>
        <span class="dot dot-yellow"></span>
        <span class="dot dot-green"></span>
      </div>
      <div class="l-terminal-body">
        <span class="l-terminal-prompt">$</span>
        <code id="cta-cmd">{command}<span class="l-cursor" aria-hidden="true"></span></code>
        <button class="l-copy-btn" aria-label="Copy command" data-command={command}>
          <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </button>
      </div>
    </div>
    <a href="https://docs.bounda.dev/getting-started/" class="l-docs-link">Read the docs →</a>
    <p class="l-cta-alpha">
      Alpha: every published version is a prerelease and the API can change between them.
      <a href="https://www.npmjs.com/org/bounda-dev" target="_blank" rel="noopener">The packages on npm</a>.
    </p>
  </div>
</section>

<style>
  .l-cta-alpha {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-muted, #94a3b8);
  }

  .l-cta-alpha a {
    color: inherit;
    text-decoration: underline;
  }

  .l-cta {
    position: relative;
    padding-block: var(--section-gap);
    overflow: hidden;
  }

  .l-cta-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 400px;
    background: radial-gradient(
      ellipse 60% 50% at 50% 50%,
      rgba(59, 130, 246, 0.08) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  :global([data-theme="light"]) .l-cta-glow {
    background: radial-gradient(
      ellipse 60% 50% at 50% 50%,
      rgba(59, 130, 246, 0.1) 0%,
      transparent 70%
    );
  }

  .l-cta-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  .l-terminal {
    width: 100%;
    max-width: 560px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 2px);
    overflow: hidden;
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.4),
      0 0 60px rgba(59, 130, 246, 0.05);
    transition: box-shadow 0.3s;
  }

  .l-terminal:hover {
    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.5),
      0 0 80px rgba(59, 130, 246, 0.1);
  }

  :global([data-theme="light"]) .l-terminal {
    box-shadow:
      0 8px 30px rgba(0, 0, 0, 0.08),
      0 0 40px rgba(59, 130, 246, 0.03);
  }

  :global([data-theme="light"]) .l-terminal:hover {
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.12),
      0 0 60px rgba(59, 130, 246, 0.06);
  }

  .l-terminal-bar {
    display: flex;
    gap: 0.4rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 50%, var(--bg));
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-red { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green { background: #28c840; }

  .l-terminal-body {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem 1.25rem;
  }

  .l-terminal-prompt {
    color: var(--accent);
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .l-terminal-body code {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.85rem;
    color: var(--fg);
    flex: 1;
    text-align: left;
    overflow-x: auto;
    white-space: nowrap;
  }

  .l-cursor {
    display: inline-block;
    width: 2px;
    height: 0.9em;
    background: var(--accent);
    margin-left: 2px;
    vertical-align: text-bottom;
    animation: blink 1.1s step-end infinite;
  }

  .l-copy-btn {
    color: var(--fg-muted);
    padding: 0.4rem;
    border-radius: 4px;
    flex-shrink: 0;
    transition: color 0.2s, background 0.2s;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .l-copy-btn:hover {
    color: var(--fg);
    background: var(--border);
  }

  .l-copy-btn .check-icon { display: none; }
  .l-copy-btn.copied .copy-icon { display: none; }
  .l-copy-btn.copied .check-icon { display: block; color: #28c840; }

  .l-docs-link {
    display: inline-block;
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
    transition: color 0.2s;
  }

  .l-docs-link:hover {
    color: var(--fg);
  }
</style>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>(".l-copy-btn");
  if (copyBtn) {
    copyBtn.addEventListener("click", async () => {
      const cmd = copyBtn.dataset.command ?? "";
      await navigator.clipboard.writeText(cmd);
      copyBtn.classList.add("copied");
      setTimeout(() => copyBtn.classList.remove("copied"), 2000);
    });
  }
</script>
