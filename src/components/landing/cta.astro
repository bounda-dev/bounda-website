---
import Install from "../install.astro";
---

<section class="cta" id="cta">
  <div class="wrap">
    <div class="box" data-reveal>
      <p class="label eyebrow">Start</p>
      <h2 class="display">Start with one aggregate.</h2>
      <p>Scaffold a project with a domain, a read model and a test, on SQLite, PostgreSQL or Cloudflare.</p>
      <Install />
      <div class="links">
        <a class="text-link" href="https://docs.bounda.dev/getting-started/">Documentation</a>
        <a class="text-link" href="https://github.com/bounda-dev/bounda">GitHub</a>
      </div>
      <p class="note">
        Before 1.0 a minor release can change the API. <a href="https://www.npmjs.com/org/bounda-dev">The packages on npm</a>.
      </p>
    </div>
  </div>
</section>

<style>
  /* Transparent, so the ⅃ comes back into view behind it. */
  .cta {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: flex-start;
    min-height: 100vh;
    padding-top: clamp(96px, 16vh, 150px);
    border-top: 1px solid var(--rule);
  }

  .wrap {
    width: 100%;
  }

  .box {
    max-width: 620px;
  }

  .eyebrow {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--accent);
  }

  h2 {
    margin: 20px 0 22px;
    font-size: clamp(2.1rem, 1.2rem + 3.6vw, 4.8rem);
    line-height: 0.98;
    letter-spacing: -0.012em;
  }

  .box > p:not(.label) {
    max-width: 40ch;
    margin: 0 0 32px;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px 28px;
    margin-top: 32px;
  }

  .box > .note {
    margin: 28px 0 0;
    font-size: 0.875rem;
  }

  .note a {
    color: var(--text);
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  @media (max-width: 760px) {
    .cta {
      align-items: flex-end;
      padding-top: 0;
      padding-bottom: 56px;
    }

    h2 {
      margin-top: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta {
      background: var(--bg);
    }
  }
</style>
