</header>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 10000;
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: var(--radius);
    transition: top 0.2s;
  }

  .skip-link:focus {
    top: 1rem;
  }

  .l-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: transparent;
    backdrop-filter: blur(0);
    border-bottom: 1px solid transparent;
    transition:
      background 0.45s var(--ease-spring),
      backdrop-filter 0.45s var(--ease-spring),
      border-color 0.45s var(--ease-spring);
  }

  .l-nav[data-scrolled] {
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(16px) saturate(180%);
    border-bottom-color: var(--border);
  }

  .l-nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 60px;
    gap: 1rem;
  }

  .l-nav-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    color: var(--fg);
    display: flex;
    align-items: center;
    flex-shrink: 0;
    opacity: 0;
    /* -50% cancels the left/top 50% offset; the extra -6px gives the subtle upward entry */
    transform: translate(-50%, calc(-50% - 6px)) scale(0.95);
    pointer-events: none;
    will-change: transform, opacity;
    /* No CSS transition — JS drives all animation via scroll */
  }

  /* Stroke draw animation on the nav logo's "b" lettermark — mirrors hero timing */
  .nav-wm-v {
    stroke-dasharray: 65;
    stroke-dashoffset: 65;
    animation: drawLine 0.55s var(--ease-spring) 0.15s both;
  }

  .nav-wm-h {
    stroke-dasharray: 30;
    stroke-dashoffset: 30;
    animation: drawLine 0.4s var(--ease-spring) 0.5s both;
  }

  .l-nav[data-scrolled] .l-nav-logo {
    opacity: 1;
    transform: translate(-50%, -50%);
    pointer-events: auto;
  }

  .l-nav-logo:hover { opacity: 0.7; }

  /* Links and toggle reveal only once the logo has fully landed (data-links-ready) */
  .l-nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.35s var(--ease-spring),
      transform 0.35s var(--ease-spring);
    transition-delay: 0.05s;
  }

  .l-nav[data-links-ready] .l-nav-links {
    opacity: 1;
    transform: none;
  }

  .l-nav-docs {
    padding: 0.4rem 1rem;
    font-size: 0.8rem;
  }

  .l-nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius);
    color: var(--fg-muted);
    transition: color 0.2s, background 0.2s;
  }

  .l-nav-icon:hover {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.06);
  }

  :global([data-theme="light"]) .l-nav-icon:hover {
    background: rgba(0, 0, 0, 0.06);
  }

  .l-nav-theme {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius);
    color: var(--fg-muted);
    transition: color 0.2s, background 0.2s;
  }

  .l-nav-theme:hover {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.06);
  }

  :global([data-theme="light"]) .l-nav-theme:hover {
    background: rgba(0, 0, 0, 0.06);
  }

  :global([data-theme="dark"]) .l-nav-theme .icon-sun { display: none; }
  :global([data-theme="light"]) .l-nav-theme .icon-moon { display: none; }

  .l-nav-docs-short { display: none; }

  @media (max-width: 767px) {
    .l-nav {
      position: fixed;
      top: auto;
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      left: 50%;
      right: auto;
      width: max-content;
      max-width: calc(100vw - 2.5rem);
      height: auto;
      border-radius: 100px;
      border: 1px solid var(--border);
      border-bottom: none;
      background: color-mix(in srgb, var(--bg) 82%, transparent);
      backdrop-filter: blur(20px) saturate(160%);
      -webkit-backdrop-filter: blur(20px) saturate(160%);
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.35),
        0 2px 8px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
      opacity: 0;
      pointer-events: none;
      transform: translateX(-50%) translateY(24px) scale(0.92);
      transition:
        opacity 0.6s var(--ease-spring),
        transform 0.6s var(--ease-spring);
    }

    .l-nav[data-scrolled] {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0) scale(1);
    }

    :global([data-theme="light"]) .l-nav {
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.1),
        0 2px 8px rgba(0, 0, 0, 0.06),
        inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }

    :global(#main-content) {
      padding-top: 0;
      padding-bottom: calc(88px + env(safe-area-inset-bottom, 0px));
    }

    .l-nav-inner {
      height: 52px;
      padding-inline: 1.25rem;
      gap: 1.25rem;
    }

    .l-nav-logo {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      opacity: 1;
      pointer-events: auto;
      margin-right: auto;
      transition: opacity 0.2s;
    }

    .l-nav[data-scrolled] .l-nav-logo {
      left: auto;
      transform: none;
    }

    .nav-wm-v { stroke-dashoffset: 0; animation: none; }
    .nav-wm-h { stroke-dashoffset: 0; animation: none; }

    .l-nav-links {
      gap: 0.75rem;
      opacity: 1;
      transform: none;
      transition: none;
    }

    .l-nav-docs {
      font-size: 0.72rem;
      padding: 0.35rem 0.75rem;
    }

    .l-nav-docs-full { display: none; }
    .l-nav-docs-short { display: inline; }
  }
</style>

<script>
  // Theme toggle
  const html = document.documentElement;
  const getTheme = () => localStorage.getItem("theme") ||
    (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
  const setTheme = (theme: string) => {
    html.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
  };
  setTheme(getTheme());

  const toggleTheme = () => {
    const current = html.getAttribute("data-theme") || "dark";
    setTheme(current === "dark" ? "light" : "dark");
  };

  document.getElementById("theme-toggle-desktop")?.addEventListener("click", toggleTheme);

  // Scroll-driven logo integration
  const nav = document.getElementById("site-nav");
  const hero = document.querySelector<HTMLElement>(".l-hero");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const isMobile = window.innerWidth < 768;

  if (nav && hero && isMobile) {
    // Show pill after scrolling 40% of hero, hide again below 20% (hysteresis)
    let pillVisible = false;
    let raf = 0;

    const updatePill = () => {
      const h = hero.offsetHeight;
      const show  = h * 0.40;
      const hide  = h * 0.20;
      const y = window.scrollY;

      const shouldShow = pillVisible ? y > hide : y > show;
      if (shouldShow === pillVisible) return;
      pillVisible = shouldShow;
      if (shouldShow) {
        nav.setAttribute("data-scrolled", "");
        nav.setAttribute("data-links-ready", "");
      } else {
        nav.removeAttribute("data-scrolled");
        nav.removeAttribute("data-links-ready");
      }
    };

    window.addEventListener("scroll", () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(updatePill);
    }, { passive: true });
    updatePill(); // handle reload mid-scroll
  }

  if (nav && hero && !isMobile) {
    const navLogoEl = nav.querySelector<HTMLElement>(".l-nav-logo");
    const heroLogoEl = hero.querySelector<HTMLElement>(".l-hero-wordmark");
    const heroSvg = heroLogoEl?.querySelector<SVGElement>("svg");
    const navSvg = navLogoEl?.querySelector<SVGElement>("svg");

    if (!prefersReducedMotion && navLogoEl && heroLogoEl && heroSvg && navSvg) {
      // Mutable positions — recomputed on resize
      let heroDocMidY = 0, navMidY = 0, scaleMax = 1, RANGE = 1;

      const computePositions = () => {
        const heroR = heroSvg.getBoundingClientRect();

        // .l-hero-wordmark has animation: fadeUp which starts at translateY(20px).
        // getBoundingClientRect() includes the animated transform, so the measurement
        // varies depending on how far the animation has progressed when this runs
        // (cold cache → animation not started → +20px; warm cache → partially played
        // → +15px, etc.). Subtract the current Y translation to always get the
        // stable final position the element will settle at.
        const animMatrix = new DOMMatrix(getComputedStyle(heroLogoEl).transform);
        heroDocMidY = heroR.top + heroR.height / 2 + window.scrollY - animMatrix.m42;

        // Temporarily reveal nav logo to get its final viewport position
        nav.setAttribute("data-scrolled", "");
        navLogoEl.style.cssText = "transition:none;opacity:1;transform:translate(-50%,-50%);pointer-events:auto";
        navLogoEl.offsetHeight;
        const navR = navSvg.getBoundingClientRect();
        navMidY = navR.top + navR.height / 2;
        nav.removeAttribute("data-scrolled");
        navLogoEl.style.cssText = "";

        scaleMax = heroR.height / Math.max(navR.height, 1);
        RANGE = Math.round(window.innerHeight * 0.65);
      };

      computePositions();

      // Hero wordmark permanently hidden — nav logo is the single visible element
      heroLogoEl.style.visibility = "hidden";

      let raf = 0;
      let lastRaw = -1;
      let navScrolled = false;
      let linksReady = false;

      const update = () => {
        const raw = Math.max(0, Math.min(1, window.scrollY / RANGE));

        // Always process boundary crossings; skip tiny mid-range movements
        const crossesBoundary = (lastRaw < 1 && raw >= 1) || (lastRaw >= 1 && raw < 1);
        if (!crossesBoundary && Math.abs(raw - lastRaw) < 0.001) return;
        lastRaw = raw;

        // Fully integrated — hand off to CSS; reveal links
        if (raw >= 1) {
          navLogoEl.style.cssText = "";
          if (!navScrolled) { nav.setAttribute("data-scrolled", ""); navScrolled = true; }
          if (!linksReady) { nav.setAttribute("data-links-ready", ""); linksReady = true; }
          return;
        }

        // Below threshold: ensure links are hidden again when scrolling back up
        if (linksReady) { nav.removeAttribute("data-links-ready"); linksReady = false; }

        // Single logo, always visible, travels linearly from hero → nav as raw goes 0 → 1
        const heroViewY = heroDocMidY - window.scrollY;
        const interpY = heroViewY + (navMidY - heroViewY) * raw;
        const scale = scaleMax + (1 - scaleMax) * raw;

        navLogoEl.style.cssText = [
          "position:absolute",
          "left:50%",
          `top:${interpY.toFixed(1)}px`,
          `transform:translate(-50%,-50%) scale(${scale.toFixed(3)})`,
          "opacity:1",
          "transition:none",
          "pointer-events:auto",
        ].join(";");

        const shouldNav = raw > 0.5;
        if (shouldNav !== navScrolled) {
          if (shouldNav) nav.setAttribute("data-scrolled", "");
          else nav.removeAttribute("data-scrolled");
          navScrolled = shouldNav;
        }
      };

      window.addEventListener("scroll", () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(update);
      }, { passive: true });

      // Recompute on resize (positions and RANGE change with viewport)
      let resizeTimer = 0;
      window.addEventListener("resize", () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          computePositions();
          lastRaw = -1; // force full re-render with fresh positions
          update();
        }, 150) as unknown as number;
      }, { passive: true });

      update(); // handle reload mid-scroll

    } else {
      // Reduced motion: instant reveal via IntersectionObserver
      new IntersectionObserver(
        ([entry]) => {
          if (entry.intersectionRatio < 0.6) {
            nav.setAttribute("data-scrolled", "");
            nav.setAttribute("data-links-ready", "");
          } else {
            nav.removeAttribute("data-scrolled");
            nav.removeAttribute("data-links-ready");
          }
        },
        { threshold: [0, 0.2, 0.4, 0.6, 0.8, 1] }
      ).observe(hero);
    }
  }
</script>
