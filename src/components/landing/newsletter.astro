---
import Subscribe from "../subscribe.astro";
---

<!-- The blog's newsletter, after the call to action and on the page's ground, clear of the scene. -->
<section class="newsletter">
  <div class="wrap">
    <Subscribe />
  </div>
</section>

<style>
  .newsletter {
    position: relative;
    z-index: 5;
    padding: 64px 0 72px;
    border-top: 1px solid var(--rule);
    background: var(--bg);
  }

  @media (max-width: 760px) {
    .newsletter {
      padding: 48px 0 56px;
    }
  }
</style>
