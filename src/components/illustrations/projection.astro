---
---

<div class="il-proj" aria-hidden="true">
  <div class="proj-label">Projector</div>
  <div class="proj-event">
    <span class="proj-dot"></span>
    <span class="proj-evt-name">OrderPlaced</span>
  </div>
  <div class="proj-connector">
    <div class="proj-line"></div>
    <div class="proj-travel-dot"></div>
  </div>
  <div class="proj-row">
    <span class="proj-cell">id</span>
    <span class="proj-cell">placed</span>
    <span class="proj-cell">$42</span>
  </div>
</div>

<style>
  .il-proj {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: 0.15rem 0 0.5rem;
    font-family: "SF Mono", "Fira Code", monospace;
  }

  .proj-event {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    border-radius: 5px;
    background: rgba(139, 92, 246, 0.07);
    border: 1px solid rgba(139, 92, 246, 0.18);
    width: 100%;
    justify-content: center;
    animation: evtAppear 3.5s ease-in-out infinite;
  }

  .proj-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(139, 92, 246, 0.85);
    box-shadow: 0 0 6px rgba(139, 92, 246, 0.6);
    flex-shrink: 0;
  }

  .proj-evt-name {
    font-size: 0.66rem;
    color: rgba(196, 181, 253, 0.9);
  }

  .proj-connector {
    position: relative;
    width: 2px;
    height: 28px;
    flex-shrink: 0;
    animation: connectorAppear 3.5s ease-in-out infinite;
  }

  .proj-line {
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(139, 92, 246, 0.28), rgba(59, 130, 246, 0.28));
  }

  .proj-travel-dot {
    position: absolute;
    top: -3px;
    left: 50%;
    transform: translateX(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(139, 92, 246, 0.9);
    box-shadow: 0 0 8px rgba(139, 92, 246, 0.7);
    animation: projDot 3.5s ease-in-out infinite;
  }

  .proj-row {
    display: flex;
    gap: 0.3rem;
    width: 100%;
    animation: rowAppear 3.5s ease-in-out infinite;
  }

  .proj-cell {
    flex: 1;
    text-align: center;
    font-size: 0.62rem;
    padding: 0.28rem 0.4rem;
    border-radius: 3px;
    border: 1px solid rgba(59, 130, 246, 0.14);
    background: rgba(59, 130, 246, 0.05);
    color: rgba(147, 197, 253, 0.8);
  }

  .proj-label {
    font-size: 0.62rem;
    color: rgba(161, 161, 170, 0.5);
    text-align: center;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-family: "SF Mono", "Fira Code", monospace;
    margin-bottom: 0.45rem;
  }

  @keyframes connectorAppear {
    0%, 95%, 100% { opacity: 0; }
    10%, 70%      { opacity: 1; }
  }

  @keyframes evtAppear {
    0%, 95%, 100% { opacity: 0; transform: translateX(-4px); }
    10%, 70%      { opacity: 1; transform: translateX(0); }
  }

  @keyframes projDot {
    0%        { top: -3px; opacity: 0; }
    12%       { opacity: 1; }
    75%       { top: calc(100% + 3px); opacity: 0; }
    100%      { top: calc(100% + 3px); opacity: 0; }
  }

  @keyframes rowAppear {
    0%, 55%   { opacity: 0; transform: translateY(3px); }
    68%, 80%  { opacity: 1; transform: translateY(0); box-shadow: 0 0 12px rgba(59, 130, 246, 0.12); }
    95%, 100% { opacity: 0; transform: translateY(0); }
  }

  /* ── Light mode overrides ────────────────────────────────── */
  :global([data-theme="light"]) .proj-label {
    color: rgb(100, 116, 139);
  }

  :global([data-theme="light"]) .proj-event {
    background: rgb(237, 233, 254);   /* violet-100 */
    border-color: rgb(196, 181, 253); /* violet-300 */
  }

  :global([data-theme="light"]) .proj-dot {
    background: rgb(109, 40, 217);    /* violet-700 */
    box-shadow: 0 0 6px rgba(109, 40, 217, 0.4);
  }

  :global([data-theme="light"]) .proj-evt-name {
    color: rgb(76, 29, 149);          /* violet-900 */
  }

  :global([data-theme="light"]) .proj-line {
    background: linear-gradient(to bottom, rgb(196, 181, 253), rgb(147, 197, 253));
  }

  :global([data-theme="light"]) .proj-cell {
    background: rgb(219, 234, 254);   /* blue-100 */
    border-color: rgb(147, 197, 253); /* blue-300 */
    color: rgb(29, 78, 216);          /* blue-700 */
  }
</style>
