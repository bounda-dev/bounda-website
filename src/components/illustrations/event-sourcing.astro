---
---

<div class="il-es" aria-hidden="true">
  <div class="ledger-label">Event Store</div>
  <div class="ledger">
    <div class="event-row row-1">
      <span class="evt-dot"></span>
      <span class="evt-name">OrderPlaced</span>
      <span class="evt-time">0ms</span>
    </div>
    <div class="event-row row-2">
      <span class="evt-dot"></span>
      <span class="evt-name">OrderConfirmed</span>
      <span class="evt-time">+142ms</span>
    </div>
    <div class="event-row row-3">
      <span class="evt-dot"></span>
      <span class="evt-name">OrderShipped</span>
      <span class="evt-time">+381ms</span>
    </div>
    <div class="event-row row-4">
      <span class="evt-dot"></span>
      <span class="evt-name">OrderDelivered</span>
      <span class="evt-time">+512ms</span>
    </div>
  </div>
</div>

<style>
  .il-es {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0.15rem 0 0.5rem;
  }

  .ledger {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-family: "SF Mono", "Fira Code", monospace;
  }

  .event-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    background: rgba(139, 92, 246, 0.06);
    border: 1px solid rgba(139, 92, 246, 0.12);
    opacity: 0;
    transform: translateX(-6px);
  }

  .evt-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(139, 92, 246, 0.8);
    box-shadow: 0 0 5px rgba(139, 92, 246, 0.6);
    flex-shrink: 0;
  }

  .evt-name { color: rgba(250, 250, 250, 0.85); flex: 1; }
  .evt-time  { color: rgba(161, 161, 170, 0.7); font-size: 0.65rem; }

  /* 8s cycle: rows accumulate one by one, stay visible, then quick fade near end */
  .row-1 { animation: row1 8s linear infinite; }
  .row-2 { animation: row2 8s linear infinite; }
  .row-3 { animation: row3 8s linear infinite; }
  .row-4 { animation: row4 8s linear infinite; }

  /* Row 1 — appears at 0s */
  @keyframes row1 {
    0%   { opacity: 0; transform: translateX(-8px); }
    4%   { opacity: 1; transform: translateX(0); }
    88%  { opacity: 1; transform: translateX(0); }
    96%  { opacity: 0; transform: translateX(0); }
    100% { opacity: 0; transform: translateX(0); }
  }

  /* Row 2 — appears at 0.8s (10%) */
  @keyframes row2 {
    0%   { opacity: 0; transform: translateX(-8px); }
    10%  { opacity: 0; transform: translateX(-8px); }
    14%  { opacity: 1; transform: translateX(0); }
    88%  { opacity: 1; transform: translateX(0); }
    96%  { opacity: 0; transform: translateX(0); }
    100% { opacity: 0; transform: translateX(0); }
  }

  /* Row 3 — appears at 1.6s (20%) */
  @keyframes row3 {
    0%   { opacity: 0; transform: translateX(-8px); }
    20%  { opacity: 0; transform: translateX(-8px); }
    24%  { opacity: 1; transform: translateX(0); }
    88%  { opacity: 1; transform: translateX(0); }
    96%  { opacity: 0; transform: translateX(0); }
    100% { opacity: 0; transform: translateX(0); }
  }

  /* Row 4 — appears at 2.4s (30%) */
  @keyframes row4 {
    0%   { opacity: 0; transform: translateX(-8px); }
    30%  { opacity: 0; transform: translateX(-8px); }
    34%  { opacity: 1; transform: translateX(0); }
    88%  { opacity: 1; transform: translateX(0); }
    96%  { opacity: 0; transform: translateX(0); }
    100% { opacity: 0; transform: translateX(0); }
  }

  .ledger-label {
    font-size: 0.62rem;
    color: rgba(161, 161, 170, 0.5);
    text-align: center;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-family: "SF Mono", "Fira Code", monospace;
    margin-bottom: 0.45rem;
  }

  /* ── Light mode overrides ────────────────────────────────── */
  :global([data-theme="light"]) .ledger-label {
    color: rgb(100, 116, 139);
  }

  :global([data-theme="light"]) .event-row {
    background: rgb(237, 233, 254);   /* violet-100 */
    border-color: rgb(196, 181, 253); /* violet-300 */
  }

  :global([data-theme="light"]) .evt-dot {
    background: rgb(109, 40, 217);    /* violet-700 */
    box-shadow: 0 0 5px rgba(109, 40, 217, 0.4);
  }

  :global([data-theme="light"]) .evt-name {
    color: rgb(76, 29, 149);          /* violet-900 */
  }

  :global([data-theme="light"]) .evt-time {
    color: rgb(100, 116, 139);
  }
</style>
