---
---

<div class="il-cmd" aria-hidden="true">
  <div class="cmd-title">Domain</div>
  <div class="cmd-block cmd-in">
    <span class="blk-dot"></span>
    <span class="blk-text">PlaceOrder</span>
  </div>
  <div class="cmd-connector">
    <div class="cmd-line"></div>
    <div class="cmd-dot"></div>
  </div>
  <div class="cmd-block cmd-out">
    <span class="blk-dot out-dot"></span>
    <span class="blk-text out-text">OrderPlaced</span>
  </div>
</div>

<style>
  .il-cmd {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: 0.15rem 0 0.5rem;
    font-family: "SF Mono", "Fira Code", monospace;
  }

  .cmd-title {
    font-size: 0.62rem;
    color: rgba(161, 161, 170, 0.5);
    text-align: center;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.45rem;
  }

  .cmd-block {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.38rem 0.75rem;
    border-radius: 5px;
    width: 100%;
  }

  .cmd-in {
    background: rgba(59, 130, 246, 0.07);
    border: 1px solid rgba(59, 130, 246, 0.18);
    animation: inPulse 3s ease-in-out infinite;
  }

  .cmd-out {
    background: rgba(34, 197, 94, 0.06);
    border: 1px solid rgba(34, 197, 94, 0.16);
    animation: outGlow 3s ease-in-out infinite;
  }

  .blk-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(59, 130, 246, 0.8);
    box-shadow: 0 0 6px rgba(59, 130, 246, 0.5);
    flex-shrink: 0;
  }

  .out-dot {
    background: rgba(34, 197, 94, 0.8);
    box-shadow: 0 0 6px rgba(34, 197, 94, 0.5);
  }

  .blk-text {
    font-size: 0.65rem;
    color: rgba(147, 197, 253, 0.85);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .out-text {
    color: rgba(134, 239, 172, 0.85);
  }

  .cmd-connector {
    position: relative;
    width: 2px;
    height: 28px;
    flex-shrink: 0;
  }

  .cmd-line {
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(59, 130, 246, 0.25), rgba(34, 197, 94, 0.25));
  }

  .cmd-dot {
    position: absolute;
    top: -3px;
    left: 50%;
    transform: translateX(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    animation: dotTravel 3s ease-in-out infinite;
  }

  @keyframes inPulse {
    0%, 100% { box-shadow: none; }
    8%, 25%  { box-shadow: 0 0 10px rgba(59, 130, 246, 0.18); }
  }

  @keyframes dotTravel {
    0%        { top: -3px; opacity: 0; background: rgba(59, 130, 246, 0.9); box-shadow: 0 0 8px rgba(59, 130, 246, 0.7); }
    10%       { opacity: 1; }
    85%       { opacity: 1; background: rgba(34, 197, 94, 0.9); box-shadow: 0 0 8px rgba(34, 197, 94, 0.7); }
    90%, 100% { top: calc(100% + 3px); opacity: 0; }
  }

  @keyframes outGlow {
    0%, 45%   { box-shadow: none; opacity: 0.6; }
    62%, 80%  { box-shadow: 0 0 12px rgba(34, 197, 94, 0.18); opacity: 1; }
    96%, 100% { box-shadow: none; opacity: 0.6; }
  }

  /* ── Light mode overrides ────────────────────────────────── */
  :global([data-theme="light"]) .cmd-title {
    color: rgb(100, 116, 139);
  }

  :global([data-theme="light"]) .cmd-in {
    background: rgb(219, 234, 254);   /* blue-100 */
    border-color: rgb(147, 197, 253); /* blue-300 */
  }

  :global([data-theme="light"]) .cmd-out {
    background: rgb(220, 252, 231);   /* green-100 */
    border-color: rgb(134, 239, 172); /* green-300 */
  }

  :global([data-theme="light"]) .blk-text {
    color: rgb(29, 78, 216);  /* blue-700 */
  }

  :global([data-theme="light"]) .out-text {
    color: rgb(21, 128, 61);  /* green-700 */
  }

  :global([data-theme="light"]) .cmd-line {
    background: linear-gradient(to bottom, rgb(147, 197, 253), rgb(134, 239, 172));
  }
</style>
