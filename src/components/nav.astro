---
import Lockup from "./lockup.astro";
import ThemeToggle from "./theme-toggle.astro";
---

<a href="#main-content" class="skip-link">Skip to content</a>

<header class="nav">
  <a class="brand" href="/" aria-label="Bounda home"><Lockup /></a>
  <nav aria-label="Primary" data-enter style="--enter-delay: 0.42s">
    <ul>
      <li><a class="link" href="https://docs.bounda.dev/getting-started/">Docs</a></li>
      <li class="wide"><a class="link" href="https://demo.bounda.dev">Demo</a></li>
      <li><a class="link" href="https://github.com/bounda-dev/bounda">GitHub</a></li>
      <li><ThemeToggle /></li>
    </ul>
  </nav>
</header>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: var(--gutter);
    z-index: 20;
    padding: 10px 14px;
    background: var(--text);
    color: var(--bg);
    font: 500 0.875rem/1 var(--font-sans);
    text-decoration: none;
    border-radius: var(--radius);
  }

  .skip-link:focus {
    top: 16px;
  }

  .nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px var(--gutter);
  }

  .brand {
    display: inline-flex;
    color: var(--text);
    line-height: 0;
  }

  ul {
    display: flex;
    gap: clamp(14px, 2.2vw, 30px);
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Small type, but a finger-sized target: the padding is folded back into the margin. */
  .link {
    display: inline-block;
    padding: 12px 6px;
    margin: -12px -6px;
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 125%;
    font-size: 0.6875rem;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.16s var(--ease);
  }

  .link:hover,
  .link:focus-visible {
    color: var(--text);
  }

  @media (max-width: 760px) {
    .nav {
      padding-top: 18px;
    }

    .brand :global(.lockup) {
      height: 20px;
    }

    /* The hero's call to action already offers the demo, and the bar has no room for it. */
    .wide {
      display: none;
    }
  }
</style>
