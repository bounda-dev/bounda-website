---
import { AUTHOR, articles, readingMinutes } from "../../blog";
import { blogPath, formatDate, LANGUAGES, LOCALES, type Locale, postPath } from "../../i18n";
import BaseLayout from "../../layouts/base.astro";
import Footer from "../footer.astro";
import Nav from "../nav.astro";

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const text = LANGUAGES[locale];
const all = await articles(locale);
const site = Astro.site ?? new URL("https://bounda.dev");
const alternates = LOCALES.map((other) => ({ tag: LANGUAGES[other].tag, href: new URL(blogPath(other), site).href }));

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Bounda blog",
  description: text.lead,
  url: new URL(blogPath(locale), site).href,
  inLanguage: text.tag,
  publisher: { "@id": `${site.href}#organization` },
  author: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url },
  blogPost: all.map((article) => ({
    "@type": "BlogPosting",
    headline: article.title,
    url: new URL(postPath(locale, article.slug), site).href,
    datePublished: article.date.toISOString(),
  })),
};
---

<BaseLayout
  title={`${text.blog} — Bounda`}
  description={text.lead}
  lang={text.tag}
  ogLocale={text.ogLocale}
  alternates={alternates}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>
  <Nav />
  <main id="main-content" class="blog">
    <div class="wrap">
      <header class="head">
        <p class="label">{text.blog}</p>
        <h1 class="display">{text.heading}</h1>
        <p class="lead">{text.lead}</p>
        <div class="links">
          <a class="text-link dim" href="/blog/rss.xml">{text.rss}</a>
          <nav class="languages" aria-label={text.languages}>
            <ul>
              {LOCALES.map((other) => (
                <li>
                  <a
                    href={blogPath(other)}
                    hreflang={LANGUAGES[other].tag}
                    lang={LANGUAGES[other].tag}
                    aria-current={other === locale ? "page" : undefined}
                  >
                    {LANGUAGES[other].name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </header>
      {
        all.length === 0 ? (
          <p class="empty">{text.empty}</p>
        ) : (
          <ol class="ledger">
            {all.map((article, index) => (
              <li>
                <span class="position">{String(all.length - index).padStart(3, "0")}</span>
                <div class="entry">
                  <p class="label">
                    {text.kinds[article.kind]}
                    {article.draft && <span class="draft">Draft</span>}
                  </p>
                  <h2>
                    <a href={postPath(locale, article.slug)}>{article.title}</a>
                  </h2>
                  <p class="description">{article.description}</p>
                </div>
                <p class="when">
                  <time datetime={article.date.toISOString()}>{formatDate(locale, article.date)}</time>
                  <span>{text.minutes(readingMinutes(article))}</span>
                </p>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .blog {
    padding: clamp(112px, 16vh, 160px) 0 clamp(80px, 12vh, 128px);
  }

  .head {
    max-width: 68ch;
    margin-bottom: 56px;
  }

  h1 {
    margin: 20px 0 22px;
    font-size: clamp(2.1rem, 1.2rem + 3.6vw, 4.2rem);
    line-height: 0.98;
    letter-spacing: -0.012em;
  }

  .lead {
    margin: 0 0 26px;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: center;
  }

  .languages ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .languages a {
    color: var(--muted);
    text-decoration: none;
  }

  .languages a:hover,
  .languages a[aria-current="page"] {
    color: var(--text);
  }

  .languages a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }

  .empty {
    color: var(--muted);
  }

  /* The ledger grammar: position first, in mono and muted; a hairline between entries. */
  .ledger {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .ledger li {
    display: grid;
    grid-template-columns: 4.5ch minmax(0, 1fr) auto;
    gap: 8px 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
  }

  .position,
  .when {
    font: 400 0.8125rem/1.9 var(--font-mono);
    color: var(--muted);
  }

  .when {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin: 0;
  }

  .entry {
    max-width: 68ch;
  }

  .draft {
    margin-left: 12px;
    padding: 3px 5px;
    border: 1px solid var(--warning);
    color: var(--warning);
  }

  h2 {
    margin: 10px 0 8px;
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 104%;
    font-size: 1.5rem;
    line-height: 1.15;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent-text);
  }

  .description {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .ledger li {
      grid-template-columns: minmax(0, 1fr);
    }

    .position {
      display: none;
    }

    .when {
      flex-direction: row;
      gap: 16px;
      align-items: baseline;
    }
  }
</style>
