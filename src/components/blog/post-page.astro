---
import { render } from "astro:content";
import { type Article, AUTHOR, articles, readingMinutes } from "../../blog";
import { blogPath, formatDate, LANGUAGES, postPath } from "../../i18n";
import BaseLayout from "../../layouts/base.astro";
import "../../styles/prose.css";
import Footer from "../footer.astro";
import Nav from "../nav.astro";
import newsletter from "../../newsletter.json";
import Subscribe from "../subscribe.astro";

interface Props {
  readonly article: Article;
}

const { article } = Astro.props;
const { locale, slug, title, description, date, updated, kind, tryIt, draft, locales } = article;
const text = LANGUAGES[locale];
const { Content } = await render(article.entry);
const minutes = readingMinutes(article);
const others = (await articles(locale)).filter((other) => other.slug !== slug).slice(0, 3);

const site = Astro.site ?? new URL("https://bounda.dev");
const url = new URL(postPath(locale, slug), site).href;
const image = new URL(`${postPath(locale, slug)}og.png`, site);
const alternates = locales.map((other) => ({ tag: LANGUAGES[other].tag, href: new URL(postPath(other, slug), site).href }));

// What the page is, for search engines and the assistants that cite it.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url,
  mainEntityOfPage: url,
  image: image.href,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  inLanguage: text.tag,
  author: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url },
  publisher: { "@id": `${site.href}#organization` },
  isPartOf: { "@type": "Blog", name: "Bounda blog", url: new URL(blogPath(locale), site).href },
  about: { "@id": `${site.href}#bounda` },
  ...(locale === "en" ? {} : { translationOfWork: { "@id": new URL(postPath("en", slug), site).href } }),
};
---

<BaseLayout
  title={`${title} — Bounda`}
  description={description}
  lang={text.tag}
  ogLocale={text.ogLocale}
  alternates={alternates}
  image={{ url: image, alt: `${title}. ${description}`, type: "image/png" }}
  article={{ published: date, modified: updated, author: AUTHOR.name }}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>
  <Nav />
  <main id="main-content" class="post">
    <div class="progress" aria-hidden="true"></div>
    <article class="wrap column">
      <header class="head">
        <p class="label crumbs">
          <a href={blogPath(locale)}>{text.blog}</a><span aria-hidden="true">/</span>{text.kinds[kind]}
          {draft && <span class="draft">Draft</span>}
        </p>
        <h1 class="display">{title}</h1>
        <p class="lead">{description}</p>
        <p class="meta">
          <span class="byline">{text.by} <a href={AUTHOR.url} rel="author">{AUTHOR.name}</a></span>
          <time datetime={date.toISOString()}>{formatDate(locale, date)}</time>
          <span>{text.minutes(minutes)}</span>
        </p>
        {
          locale !== "en" && (
            <p class="translated">
              {text.translated} <a href={postPath("en", slug)} hreflang="en">{text.original}</a>
              {
                text.report && (
                  <>
                    {" · "}
                    <a href={`https://github.com/bounda-dev/bounda-website/issues/new?title=${encodeURIComponent(`Translation (${locale}): ${slug}`)}`}>
                      {text.report}
                    </a>
                  </>
                )
              }
            </p>
          )
        }
        {tryIt && <a class="text-link see-it" href={tryIt.href}>{text.seeItRun}</a>}
      </header>
      <div class="prose">
        <Content />
      </div>
      {
        locale === "en" && locales.length > 1 && (
          <p class="also-in">
            {text.alsoIn}{" "}
            {locales
              .filter((other) => other !== "en")
              .map((other, index) => (
                <>
                  {index > 0 && " · "}
                  <a href={postPath(other, slug)} hreflang={LANGUAGES[other].tag} lang={LANGUAGES[other].tag}>
                    {LANGUAGES[other].name}
                  </a>
                </>
              ))}
          </p>
        )
      }
      <svg class="close" viewBox="0 0 35 65" aria-hidden="true"><path d="M25 0h10v65H25v-8H0v-6h25z"></path></svg>
    </article>

    {
      (newsletter.enabled || others.length > 0) && (
      <section class="wrap after">
        {newsletter.enabled && <Subscribe locale={locale} />}
        {
          others.length > 0 && (
            <nav class="more" aria-label={text.more}>
              <p class="label">{text.more}</p>
              <ul>
                {others.map((other) => (
                  <li>
                    <a href={postPath(locale, other.slug)}>{other.title}</a>
                    <time datetime={other.date.toISOString()}>{formatDate(locale, other.date)}</time>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </section>
      )
    }
  </main>
  <Footer />
</BaseLayout>

<style>
  .post {
    padding: clamp(112px, 16vh, 160px) 0 0;
  }

  /*
   * How much of the post is left: a hairline at the top of the view, driven by the scroll itself.
   * No script and no scroll listener; it animates a transform, which the compositor handles, so it
   * costs nothing on the main thread. It runs from the article's top reaching the top of the view to
   * its end reaching the bottom, and browsers without scroll-driven animations simply show none.
   */
  .progress {
    display: none;
  }

  @supports (animation-timeline: view()) {
    .post {
      timeline-scope: --post;
    }

    article {
      view-timeline: --post block;
    }

    .progress {
      display: block;
      position: fixed;
      inset: 0 0 auto;
      z-index: 30;
      height: 2px;
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: 0 50%;
      animation: read linear both;
      animation-timeline: --post;
      animation-range: contain 0% contain 100%;
    }
  }

  @keyframes read {
    to {
      transform: scaleX(1);
    }
  }

  article {
    position: relative;
    min-width: 0;
    padding-bottom: 56px;
  }

  /* One centred column for reading, the post and what comes after it alike. */
  .column,
  .after {
    max-width: calc(68ch + 2 * var(--gutter));
  }

  .see-it {
    margin-top: 22px;
  }

  .head {
    max-width: 68ch;
    margin-bottom: 48px;
  }

  .crumbs {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--text);
  }

  .draft {
    margin-left: 6px;
    padding: 4px 6px;
    border: 1px solid var(--warning);
    color: var(--warning);
  }

  h1 {
    margin: 20px 0 22px;
    font-size: clamp(2.1rem, 1.3rem + 2.8vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.012em;
  }

  .lead {
    margin: 0 0 26px;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    font: 400 0.8125rem/1.4 var(--font-mono);
    color: var(--muted);
  }

  .meta a {
    color: var(--text);
    text-decoration: none;
  }

  .meta a:hover {
    text-decoration: underline;
  }

  .also-in {
    margin: 40px 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .also-in a {
    color: var(--muted);
  }

  .also-in a:hover {
    color: var(--text);
  }

  .translated {
    margin: 14px 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .translated a {
    color: var(--accent-text);
  }

  /* The ⅃ closes the post: the corner of a thing that is complete (DESIGN.md). */
  .close {
    display: block;
    width: 13px;
    height: 24px;
    margin: 8px 0 0 calc(min(68ch, 100%) - 13px);
    fill: var(--accent);
  }

  .after {
    display: grid;
    gap: 56px;
    padding-top: 56px;
    padding-bottom: clamp(80px, 12vh, 128px);
    border-top: 1px solid var(--rule);
  }

  .more ul {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .more li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    justify-content: space-between;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }

  .more a {
    text-decoration: none;
  }

  .more a:hover {
    color: var(--accent-text);
  }

  .more time {
    font: 400 0.8125rem/1.6 var(--font-mono);
    color: var(--muted);
  }
</style>
